# LLM provider: OpenRouter (https://openrouter.ai) - never commit the real key
API_KEY=sk-or-v1-replace-me
LLM_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# cosine similarity (1 - distance); tune with `manage.py eval_questions`
SIMILARITY_THRESHOLD=0.23
LLM_TIMEOUT=60
LLM_RETRY_BACKOFF=2

POSTGRES_DB=zesp
POSTGRES_USER=zesp
POSTGRES_PASSWORD=zesp
POSTGRES_HOST=db
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
MAX_PDF_MB=20
